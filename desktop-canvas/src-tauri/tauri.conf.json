{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Desktop Canvas",
  "version": "0.0.65",
  "identifier": "com.theorybox.desktopcanvas",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Desktop Canvas",
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}

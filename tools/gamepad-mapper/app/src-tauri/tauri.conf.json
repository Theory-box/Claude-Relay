{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GamepadMapper",
  "version": "0.1.0",
  "identifier": "com.theorybox.gamepadmapper",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gamepad Mapper",
        "width": 1000,
        "height": 640,
        "resizable": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
